# Example environment variables for local development
# Copy to a file named .env.local and edit values before running

# JWT secret used to sign auth tokens (change in production)
JWT_SECRET=your_jwt_secret_here

# Admin credentials (override defaults TVK / TVKACK)
ADMIN_USER=TVK
ADMIN_PASS=TVKACK

# Optional Gemini API key for AI draft generation
GEMINI_API_KEY=

# Supabase connection settings (optional)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY=your_anon_or_service_role_key

# In production replace OTP/SMS integration settings below as needed
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Example to enable Twilio SMS sending
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# Note: Twilio trial accounts require verification of recipient phone numbers before SMS can be sent.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Optional backend URL to use when the frontend is packaged into a native app.
# On Android emulators you can use http://10.0.2.2:3000 if the backend runs on your host machine.
# VITE_API_BASE_URL="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
