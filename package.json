{
  "name": "tvk",
  "description": "TVK citizen petition and admin app wrapped in Electron for desktop use.",
  "private": true,
  "version": "1.0.0",
  "main": "electron.cjs",
  "author": "TVK",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:exe": "npm run build && npx pkg dist/server.cjs --target node18-win-x64 --output tvk.exe",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && set \"ELECTRON_START_URL=http://127.0.0.1:3000\" && electron .\"",
    "electron:build": "npm run build && npx electron-packager . TVK --platform=win32 --arch=x64 --out=dist-electron --overwrite --asar=false --prune=true --ignore=^dist-electron$",
    "dist:exe": "npm run electron:build",
    "cap:add:android": "npx cap add android",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "build:apk": "npm run build && npx cap copy android && cd android && set \"JAVA_HOME=C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.11.10-hotspot\" && set \"PATH=%JAVA_HOME%\\bin;%PATH%\" && .\\gradlew.bat assembleDebug",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js tvk.exe",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.9",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "twilio": "^4.8.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.tvk.app",
    "productName": "TVK Software",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
